<div class="swnr chat-message injury-message">
  <div class="critical-injury-banner">
    <i class="fas fa-skull-crossbones"></i>
    {{localize 'swnr.chat.criticalInjury'}}
  </div>

  <div class="message-content">
    <div class="injury-type-indicator injury-type-{{injuryType}}">
      <strong>{{#if (eq injuryType 'minor')}}{{localize 'swnr.injury.minor'}}{{else}}{{localize 'swnr.injury.moderate'}}{{/if}}</strong>
      <span class="hp-percentage">({{currentHp}}/{{maxHp}} {{localize 'swnr.injury.hp'}} - {{hpPercentage}}%)</span>
    </div>

    <div class="injury-location">
      <i class="fas fa-{{locationIcon}} location-icon"></i>
      <strong>{{localize 'swnr.injury.locationLabel'}}:</strong> {{location}}
    </div>

    <div class="severity-section">
      <div class="roll severity-roll">
        {{{severityRollRendered}}}
      </div>
      <h4 class="severity-total">
        {{localize 'swnr.injury.severity'}} {{severity}}
      </h4>
      <details class="dice-modifiers">
        <summary>{{localize 'swnr.injury.modifiers'}}</summary>
        <div class="dice-calculation">
          <div class="dice-formula">
            {{severityDie}}: [{{severityRoll}}] + {{injuryContribution}} ({{injuries}} {{localize 'swnr.injury.injuries'}}) - {{critResistance}} (CR) = {{severity}}
          </div>
        </div>
      </details>
    </div>

    <div class="counters-update">
      <table>
        <tr>
          <td><strong>{{localize 'swnr.injury.injuries'}}:</strong></td>
          <td>{{injuryBefore}} &rarr; {{injuryAfter}}</td>
        </tr>
        <tr>
          <td><strong>{{localize 'swnr.injury.wounds'}}:</strong></td>
          <td>{{woundBefore}} &rarr; {{woundAfter}}</td>
        </tr>
      </table>
    </div>

    <div class="actor-status">
      <strong>{{actor.name}}</strong> {{localize 'swnr.injury.nowAt'}} {{currentHp}}/{{maxHp}} {{localize 'swnr.injury.hp'}}
    </div>
  </div>
</div>
